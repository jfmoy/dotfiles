#!/usr/bin/env bash
# Re-run whenever the Pacfile changes: Pacfile hash {{ includeTemplate "private_dot_config/linux/Pacfile.tmpl" . | sha256sum }}

{{ template "script_linux_only" . }}

set -euo pipefail

echo "Updating system packages..."
sudo pacman -Syu --noconfirm

echo "Installing packages from Pacfile..."
if [[ -f ~/.config/linux/Pacfile ]]; then
    grep -v '^#' ~/.config/linux/Pacfile | grep -v '^$' | awk '{print $1}' | while read -r package; do
        sudo pacman -S --needed --noconfirm "$package" || echo "Failed to install $package, continuing..."
    done
else
    echo "Pacfile not found, skipping..."
fi

echo "Done!"