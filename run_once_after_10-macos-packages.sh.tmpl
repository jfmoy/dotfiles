#!/usr/bin/env bash

{{ template "script_darwin_only" . }}
{{ template "script_no_root" . }}
{{ template "script_brew_path" . }}

cd {{ .chezmoi.sourceDir }}
pwd

{{ template "script_caffeinate" . }}

set -x

# Update Homebrew and upgrade all packages
echo "Updating Homebrew..."
brew update
echo "Upgrading Homebrew packages..."
brew upgrade

# Trust third-party taps so Homebrew will load their formulae/casks
echo "Trusting taps..."
grep -E '^[[:space:]]*tap ' ~/.config/darwin/Brewfile | sed -E 's/^[[:space:]]*tap "([^"]+)".*/\1/' | xargs -n1 brew trust --tap

# Apply common Brewfile
echo "Applying common packages..."
brew bundle --verbose --file=~/.config/darwin/Brewfile || true

# Clean up old versions and cache
echo "Cleaning up..."
brew cleanup

set +x
