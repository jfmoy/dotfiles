{{ if eq .chezmoi.os "linux" -}}
# KDE Global Shortcuts - Vim-style Window Management
# Note: These settings are merged with existing shortcuts via the setup script

[kwin]
# Focus windows (vim-style with Super key)
Switch Window Down=Meta+J,Meta+Alt+Down,Switch Window Down
Switch Window Left=Meta+H,Meta+Alt+Left,Switch Window Left
Switch Window Right=Meta+L,Meta+Alt+Right,Switch Window Right
Switch Window Up=Meta+K,Meta+Alt+Up,Switch Window Up

# Move windows (Super+Shift + vim keys)
Window Move Down=Meta+Shift+J,,Move Window Down
Window Move Left=Meta+Shift+H,,Move Window Left
Window Move Right=Meta+Shift+L,,Move Window Right
Window Move Up=Meta+Shift+K,,Move Window Up

# Tile windows (Super+Ctrl + arrow keys)
Window Quick Tile Bottom=Meta+Ctrl+Down,Meta+Down,Quick Tile Window to the Bottom
Window Quick Tile Left=Meta+Ctrl+Left,Meta+Left,Quick Tile Window to the Left
Window Quick Tile Right=Meta+Ctrl+Right,Meta+Right,Quick Tile Window to the Right
Window Quick Tile Top=Meta+Ctrl+Up,Meta+Up,Quick Tile Window to the Top

# Tile corners (Super+Ctrl + vim keys for diagonals)
Window Quick Tile Bottom Left=Meta+Ctrl+Shift+H,,Quick Tile Window to the Bottom Left
Window Quick Tile Bottom Right=Meta+Ctrl+Shift+L,,Quick Tile Window to the Bottom Right
Window Quick Tile Top Left=Meta+Ctrl+H,,Quick Tile Window to the Top Left
Window Quick Tile Top Right=Meta+Ctrl+L,,Quick Tile Window to the Top Right

# Window actions
Window Close=Meta+Q,Alt+F4,Close Window
Window Maximize=Meta+M,Meta+PgUp,Maximize Window
Window Fullscreen=Meta+F,,Make Window Fullscreen
Window Minimize=Meta+N,Meta+PgDown,Minimize Window

# Virtual desktops (Super + number)
Switch to Desktop 1=Meta+1,Ctrl+F1,Switch to Desktop 1
Switch to Desktop 2=Meta+2,Ctrl+F2,Switch to Desktop 2
Switch to Desktop 3=Meta+3,Ctrl+F3,Switch to Desktop 3
Switch to Desktop 4=Meta+4,Ctrl+F4,Switch to Desktop 4

# Move window to virtual desktop (Super+Shift + number)
Window to Desktop 1=Meta+Shift+1,,Window to Desktop 1
Window to Desktop 2=Meta+Shift+2,,Window to Desktop 2
Window to Desktop 3=Meta+Shift+3,,Window to Desktop 3
Window to Desktop 4=Meta+Shift+4,,Window to Desktop 4

# Desktop navigation
Switch to Next Desktop=Meta+Right,none,Switch to Next Desktop
Switch to Previous Desktop=Meta+Left,none,Switch to Previous Desktop

# Overview and expose
ExposeAll=Meta+Tab,Ctrl+F10,Toggle Present Windows (All Desktops)
Expose=Meta+`,Ctrl+F9,Toggle Present Windows (Current desktop)
Overview=Meta+W,Meta+W,Toggle Overview

# Window cycling
Walk Through Windows=Alt+Tab,Alt+Tab,Walk Through Windows
Walk Through Windows (Reverse)=Alt+Shift+Tab,Alt+Shift+Tab,Walk Through Windows (Reverse)

[plasmashell]
# Application launcher - Super+Space for rofi
activate application launcher=none,Meta,Activate Application Launcher

[org.kde.krunner.desktop]
# Disable KRunner (we use rofi instead)
_launch=none,Alt+Space\tAlt+F2\tSearch,KRunner
{{ end -}}
