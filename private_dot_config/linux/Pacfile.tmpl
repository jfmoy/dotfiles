# CachyOS/Arch Linux Core Packages (Official Repositories)
# Equivalent to common Homebrew packages from Brewfile

# Core CLI tools
bat                    # Clone of cat(1) with syntax highlighting
cmake                  # Cross-platform make
curl                   # Get files from HTTP/HTTPS/FTP
git                    # Distributed revision control system
git-delta              # Syntax-highlighting pager for git
fzf                    # Command-line fuzzy finder
htop                   # Improved top (interactive process viewer)
jq                     # Lightweight command-line JSON processor
neovim                 # Vim-fork focused on extensibility
python                 # Python programming language
python-pipx            # Global isolation of Python CLI applications
starship               # Cross-shell prompt
tmux                   # Terminal multiplexer
vim                    # Vi 'workalike' with many additional features
wget                   # Internet file retriever
zsh                    # Z shell
zsh-completions        # Additional completions for Zsh
diff-so-fancy          # Good-lookin' diffs
eza                    # Modern replacement for ls
ripgrep                # Search tool like grep
fd                     # Simple, fast alternative to find
zoxide                 # Smarter cd command
lazygit                # Simple terminal UI for git commands

# Development tools
docker                 # Container platform
docker-compose         # Multi-container Docker applications

# Fonts (Nerd Fonts from official repos)
ttf-firacode-nerd      # Fira Code with Nerd Font patches
ttf-jetbrains-mono-nerd # JetBrains Mono with Nerd Font patches
ttf-space-mono-nerd    # Space Mono with Nerd Font patches

{{- if eq .proMachine "true" }}
# Professional-specific packages
aws-cli                # Official Amazon AWS CLI
kubectl                # Kubernetes command-line interface
helm                   # Kubernetes package manager
terraform              # Infrastructure as code tool
pre-commit             # Git hook framework
telnet                 # User interface to TELNET protocol
unbound                # Validating DNS resolver
{{- end }}

# System utilities
chezmoi                # Dotfiles manager
flatpak                # Application distribution framework
base-devel             # Development tools (make, gcc, etc.)