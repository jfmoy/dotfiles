# Font configuration
font_family      JetBrainsMono Nerd Font
bold_font        JetBrainsMono Nerd Font Bold
italic_font      JetBrainsMono Nerd Font Italic
bold_italic_font JetBrainsMono Nerd Font Bold Italic
{{ if eq .chezmoi.os "darwin" -}}
font_size        14.0
{{ else -}}
font_size        12.0
{{ end -}}

# Cursor
cursor_shape                block
cursor_blink_interval       -1
cursor_stop_blinking_after  15.0
cursor                      #F5E0DC
cursor_text_color           #1E1E2E

# Mouse
hide_when_typing            yes

# Window layout
window_padding_width        5
enabled_layouts             *

# Window opacity
background_opacity          0.95

# Shell
{{ if eq .chezmoi.os "darwin" -}}
shell                       /bin/zsh
{{ else -}}
shell                       /usr/bin/zsh
{{ end -}}

# Scrollback
scrollback_lines            10000

# URLs
url_style                   curly
open_url_with               default

# Catppuccin Mocha color scheme
foreground                  #CDD6F4
background                  #1E1E2E

# Black
color0                      #45475A
color8                      #585B70

# Red
color1                      #F38BA8
color9                      #F38BA8

# Green
color2                      #A6E3A1
color10                     #A6E3A1

# Yellow
color3                      #F9E2AF
color11                     #F9E2AF

# Blue
color4                      #89B4FA
color12                     #89B4FA

# Magenta
color5                      #F5C2E7
color13                     #F5C2E7

# Cyan
color6                      #94E2D5
color14                     #94E2D5

# White
color7                      #BAC2DE
color15                     #A6ADC8

# Config reload
allow_remote_control        yes

{{ if eq .chezmoi.os "darwin" -}}
# macOS-specific settings
macos_option_as_alt         right
macos_quit_when_last_window_closed yes

# Cmd key navigation (macOS convention)
# Cmd+Left - beginning of line (sends Ctrl+A)
map cmd+left send_text all \x01
# Cmd+Right - end of line (sends Ctrl+E)
map cmd+right send_text all \x05
{{ end -}}
