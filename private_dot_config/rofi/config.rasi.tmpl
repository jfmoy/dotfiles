{{ if eq .chezmoi.os "linux" -}}
configuration {
    modi: "drun,run,window";
    show-icons: true;
    font: "JetBrainsMono Nerd Font 12";
    display-drun: "Apps";
    display-run: "Run";
    display-window: "Windows";
    drun-display-format: "{name}";
    terminal: "kitty";

    /* Matching */
    matching: "fuzzy";
    sort: true;
    sorting-method: "fzf";

    /* History */
    disable-history: false;
    max-history-size: 25;

    /* Behavior */
    scroll-method: 0;
    click-to-exit: true;

    /* Timeout */
    timeout {
        action: "kb-cancel";
        delay: 0;
    }

    /* Key bindings */
    kb-row-up: "Up,Control+k,Control+p";
    kb-row-down: "Down,Control+j,Control+n";
    kb-accept-entry: "Return,KP_Enter";
    kb-remove-to-eol: "";
    kb-mode-complete: "";
    /* Unbind Tab from element navigation, use for mode switching */
    kb-element-next: "";
    kb-element-prev: "";
    kb-mode-next: "Tab,Control+Tab";
    kb-mode-previous: "ISO_Left_Tab,Control+Shift+Tab";
}

@theme "~/.config/rofi/themes/catppuccin-spotlight.rasi"
{{ end -}}
