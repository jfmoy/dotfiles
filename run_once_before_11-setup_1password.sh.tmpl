#!/usr/bin/env bash

{{ template "script_no_root" . }}
{{ if eq .chezmoi.os "darwin" -}}
{{ template "script_caffeinate" . }}
{{ template "script_brew_path" . }}
{{ end -}}

{{ template "1password_check" . }}

if ! op account list &> /dev/null; then
    echo "ERROR: 1Password CLI is not authenticated."
    echo ""
    echo "Please complete these steps:"
    echo "  1. Open the 1Password desktop app"
    echo "  2. Sign in to your account(s)"
    echo "  3. Go to Settings > Developer"
    echo "  4. Enable 'Integrate with 1Password CLI'"
    echo "  5. Re-run 'chezmoi apply'"
    exit 1
fi

if ! op account list | grep -q "my.1password.com"; then
    echo "WARNING: Personal 1Password account (my.1password.com) not found."
fi

{{- if eq .proMachine "true" }}
if ! op account list | grep -q "alpacap.1password.eu"; then
    echo "WARNING: Work 1Password account (alpacap.1password.eu) not found."
fi
{{- end }}

