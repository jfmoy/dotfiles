# Maintenance functions
# System cleanup
cleanup() {
  echo "Starting system cleanup..."

  {{ if eq .chezmoi.os "darwin" -}}
  # Homebrew cleanup (macOS)
  if command -v brew &> /dev/null; then
    echo "\nCleaning Homebrew..."
    brew cleanup --prune=all
    brew autoremove
    echo "Homebrew cleaned"
  fi
  {{ else -}}
  # Pacman/paru cleanup (Linux)
  if command -v paru &> /dev/null; then
    echo "\nCleaning package cache..."
    paru -Sc --noconfirm
    echo "Package cache cleaned"
  fi
  {{ end -}}

  # Docker cleanup (if installed)
  if command -v docker &> /dev/null; then
    echo "\nCleaning Docker..."
    docker system prune -af --volumes 2>/dev/null || echo "Docker not running or no permission"
  fi

  # Git worktree cleanup (current repo only)
  if git rev-parse --git-dir > /dev/null 2>&1; then
    echo "\nPruning git worktrees..."
    git worktree prune
    echo "Git worktrees pruned"
  fi

  # Clear zsh completion cache
  echo "\nClearing zsh completion cache..."
  rm -f ~/.zcompdump*
  compinit
  echo "Completion cache cleared"

  echo "\nCleanup complete!"
}

# Update all the things
update-all() {
  echo "Updating all tools..."

  {{ if eq .chezmoi.os "darwin" -}}
  # Homebrew (macOS)
  if command -v brew &> /dev/null; then
    echo "\nUpdating Homebrew packages..."
    brew update
    brew upgrade
    brew cleanup
    echo "Homebrew updated"
  fi
  {{ else -}}
  # Pacman/paru (Linux)
  if command -v paru &> /dev/null; then
    echo "\nUpdating system packages..."
    paru -Syu --noconfirm
    echo "System packages updated"
  fi

  # Flatpak (Linux)
  if command -v flatpak &> /dev/null; then
    echo "\nUpdating Flatpak apps..."
    flatpak update -y
    echo "Flatpak apps updated"
  fi
  {{ end -}}

  # Chezmoi
  if command -v chezmoi &> /dev/null; then
    echo "\nUpdating chezmoi..."
    chezmoi update
    echo "Chezmoi updated"
  fi

  # asdf plugins
  if command -v asdf &> /dev/null; then
    echo "\nUpdating asdf plugins..."
    asdf plugin update --all
    echo "asdf plugins updated"
  fi

  # Starship
  if command -v starship &> /dev/null; then
    echo "\nChecking starship updates..."
    starship --version
  fi

  echo "\nAll updates complete!"
}

# Quick git repo maintenance
git-maintenance() {
  if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo "❌ Not in a git repository"
    return 1
  fi

  echo "🔧 Running git maintenance..."

  # Fetch with prune
  echo "\n📥 Fetching and pruning..."
  git fetch --prune --all

  # Clean merged branches
  echo "\n🌿 Cleaning merged branches..."
  git branch --merged | grep -v '\*\|main\|master\|develop' | xargs -n 1 git branch -d 2>/dev/null || echo "No merged branches to clean"

  # Prune worktrees
  echo "\n🌳 Pruning worktrees..."
  git worktree prune

  # Run git gc
  echo "\n🗑️  Running garbage collection..."
  git gc --auto

  echo "\n✅ Git maintenance complete!"
}

# Smart git worktree manager
gwt() {
  local branch_name="$1"

  if [ -z "$branch_name" ]; then
    echo "❌ Usage: gwt <branch-name>"
    return 1
  fi

  if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo "❌ Not in a git repository"
    return 1
  fi

  if [ -z "$WORKTREE_BASE_DIR" ]; then
    echo "❌ WORKTREE_BASE_DIR is not set"
    echo "   Please configure workspaceDir in chezmoi"
    return 1
  fi

  local repo_root=$(git rev-parse --show-toplevel)
  local repo_name=$(basename "$repo_root")
  local worktree_path="$WORKTREE_BASE_DIR/$repo_name/$branch_name"

  mkdir -p "$WORKTREE_BASE_DIR/$repo_name"

  if [ -d "$worktree_path" ]; then
    if git worktree list | grep -q "$worktree_path"; then
      echo "❌ Worktree already exists at: $worktree_path"
      return 1
    else
      echo "❌ Directory exists but is not a worktree: $worktree_path"
      echo "   Please remove or rename this directory"
      return 1
    fi
  fi

  echo "🌳 Creating worktree for branch '$branch_name'..."

  if git show-ref --verify --quiet refs/heads/"$branch_name"; then
    git worktree add "$worktree_path" "$branch_name"
  elif git ls-remote --heads origin "$branch_name" | grep -q "$branch_name"; then
    git worktree add --track -b "$branch_name" "$worktree_path" "origin/$branch_name"
  else
    git worktree add -b "$branch_name" "$worktree_path" HEAD
  fi

  if [ $? -eq 0 ]; then
    echo "✓ Worktree created at: $worktree_path"

    echo -n "\nChange directory to the new worktree? (y/n) "
    read -r response
    if [[ "$response" =~ ^[Yy]$ ]]; then
      cd "$worktree_path"
    else
      echo "\n💡 To change directory later, run:"
      echo "   cd $worktree_path"
    fi
  else
    echo "❌ Failed to create worktree"
    return 1
  fi
}

