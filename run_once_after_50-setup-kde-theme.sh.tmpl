{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
# Setup KDE Plasma 6 Catppuccin theme (CachyOS/Arch)
# This script runs once after chezmoi apply

set -e

echo "Setting up KDE Plasma 6 Catppuccin Mocha theme..."

# Configure Kvantum theme
KVANTUM_DIR="$HOME/.config/Kvantum"
mkdir -p "$KVANTUM_DIR"
echo -e "[General]\ntheme=Catppuccin-Mocha-Blue" > "$KVANTUM_DIR/kvantum.kvconfig"
echo "Kvantum theme configured"

# Apply Catppuccin Mocha Sapphire color scheme (should already be installed via package)
plasma-apply-colorscheme CatppuccinMochaSapphire || echo "Note: Color scheme will be applied on next login"

# Apply KWin settings
# Blur
kwriteconfig6 --file kwinrc --group Plugins --key blurEnabled true
kwriteconfig6 --file kwinrc --group "Effect-blur" --key BlurStrength 8
kwriteconfig6 --file kwinrc --group "Effect-blur" --key NoiseStrength 0

# Rounded corners (requires kwin-effect-rounded-corners-git)
kwriteconfig6 --file kwinrc --group Plugins --key shapecornersEnabled true
kwriteconfig6 --file kwinrc --group "Effect-shapecorners" --key ActiveCornerRadius 12
kwriteconfig6 --file kwinrc --group "Effect-shapecorners" --key InactiveCornerRadius 12

# Translucency for inactive windows
kwriteconfig6 --file kwinrc --group Plugins --key kwin4_effect_translucencyEnabled true
kwriteconfig6 --file kwinrc --group "Effect-kwin4_effect_translucency" --key Inactive 90

# Window decorations - buttons on right only (macOS style)
kwriteconfig6 --file kwinrc --group "org.kde.kdecoration2" --key ButtonsOnLeft ""
kwriteconfig6 --file kwinrc --group "org.kde.kdecoration2" --key ButtonsOnRight "IAX"

echo "KWin settings applied"

# Reconfigure KWin (Wayland)
qdbus6 org.kde.KWin /KWin reconfigure 2>/dev/null || true

# Create rofi launcher desktop entry (uses toggle script with full path)
mkdir -p "$HOME/.local/share/applications"
cat > "$HOME/.local/share/applications/rofi-launcher.desktop" << EOF
[Desktop Entry]
Type=Application
Name=Rofi Launcher
Exec=$HOME/.local/bin/rofi-toggle
Icon=application-menu
NoDisplay=true
EOF

echo ""
echo "Setup complete! Manual step required:"
echo "  System Settings > Keyboard > Shortcuts > Add Application"
echo "  Select 'Rofi Launcher', set shortcut to Meta+Space"
{{ end -}}
