#!/usr/bin/env bash

{{ template "script_darwin_only" . }}
{{ template "script_no_root" . }}

{{- if eq .proMachine "true" }}
set -euo pipefail

if ! command -v jira &> /dev/null; then
    echo "jira not found, skipping initialization"
    exit 0
fi

if [[ ! -f "$HOME/.config/.jira/.config.yml" ]]; then
    echo "Initializing Jira CLI..."
    jira init
    echo "Jira CLI initialized"
fi
{{- end }}
