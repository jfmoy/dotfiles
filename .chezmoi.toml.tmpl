{{- $name := promptStringOnce . "name" "Your Name" -}}

{{- $hostname := promptStringOnce . "hostname" "Hostname" -}}
{{- $email := promptStringOnce . "email" "Email address" -}}

{{- $proMachine := promptBoolOnce . "proMachine" "Professional Machine" -}}
{{- $proEmail := "" }}
{{- $proOnePasswordAccount := "" }}
{{- if $proMachine -}}
{{- $proEmail = promptStringOnce . "proEmail" "Pro Email address" -}}
{{- $proOnePasswordAccount = promptStringOnce . "proOnePasswordAccount" "Work 1Password account URL (e.g. acme.1password.eu, empty for none)" -}}
{{ end -}}

{{- $workspaceDir := promptStringOnce . "workspaceDir" "Workspace Directory (for worktrees, etc.)" -}}

[data]
  name = {{ $name | quote }}
  hostname = {{ $hostname | quote }}
  email = {{ $email | quote }}
  proMachine = {{ $proMachine | quote }}
  proEmail = {{ $proEmail | quote }}
  proOnePasswordAccount = {{ $proOnePasswordAccount | quote }}
  workspaceDir = {{ $workspaceDir | quote }}
